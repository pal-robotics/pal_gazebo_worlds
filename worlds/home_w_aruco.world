              <remapping>head_front_camera/depth/image_raw/theora:=head_front_camera/depth/image_rect_raw/theora</remapping>
              <qos>
                <topic name='head_front_camera/color/image_raw'>
                  <publisher>
                    <reliability>best_effort</reliability>
                    <durability>volatile</durability>
                    <history depth='1'>keep_last</history>
                    <liveliness>automatic</liveliness>
